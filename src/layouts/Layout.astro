```astro
---
import '../styles/global.css';
import logo from '../assets/logo.jpg';

const {
  title = 'A Fé Primitiva',
  description = 'Estudos bíblicos segundo as Escrituras.'
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.svg" />

    <title>{title} | A Fé Primitiva</title>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">

        <a class="site-logo" href="/" aria-label="A Fé Primitiva - Página inicial">
          <img
            src={logo.src}
            alt="A Fé Primitiva"
          />
        </a>

        <nav class="main-nav" aria-label="Navegação principal">
          <a href="/">
            Início
          </a>

          <a href="/estudos-doutrinarios/">
            Estudos Doutrinários
          </a>

          <a href="/estudos-diversos/">
            Estudos Diversos
          </a>

          <a href="/nosso-metodo/">
            Nosso Método
          </a>

          <a href="/grupo-de-estudos/">
            Faça Parte do Grupo de Estudos
          </a>

          <a href="/sobre/">
            Sobre
          </a>

          <a href="/envie-suas-duvidas/">
            Envie suas Dúvidas
          </a>
        </nav>

      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">

        <div class="footer-brand">
          <strong>A Fé Primitiva</strong>
          <p>
            Estudos das Escrituras em busca da Verdade.
          </p>
        </div>

        <div class="footer-line"></div>

        <p class="copyright">
          © {new Date().getFullYear()} A Fé Primitiva. Todos os direitos reservados.
        </p>

      </div>
    </footer>
  </body>
</html>
```
