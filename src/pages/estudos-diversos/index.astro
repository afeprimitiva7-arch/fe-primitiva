      </p>
    </div>

    <div class="study-page-grid">

      <a href="#" class="study-page-card">
        <span class="study-number">01</span>
        <h2>Estudo em Destaque</h2>
      </a>

      <a href="#" class="study-page-card">
        <span class="study-number">02</span>
        <h2>Outro Estudo</h2>
      </a>

    </div>

