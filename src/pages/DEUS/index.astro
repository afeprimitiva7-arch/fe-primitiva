---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Deus"
  description="Estudos bíblicos sobre Deus segundo as Escrituras."
>
  <article class="study-page">

    <header class="study-header">
      <p class="eyebrow">ESTUDOS BÍBLICOS</p>

      <h1>Deus</h1>

      <p class="study-intro">
        Estudos sobre Deus a partir da revelação apresentada
        nas Escrituras.
      </p>
    </header>

    <div class="study-divider"></div>

    <section class="study-content">

      <h2>Estudos</h2>

      <div class="study-list">

        <!-- Os estudos serão acrescentados aqui posteriormente -->

        <div class="empty-study">
          <p>
            Os estudos desta categoria serão publicados aqui.
          </p>
        </div>

      </div>

    </section>

  </article>
</Layout>
