---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Faça Parte do Grupo de Estudos"
  description="Participe do grupo de estudos da A Fé Primitiva."
>

  <section class="study-page">

    <div class="study-page-header">
      <p class="study-page-kicker">A Fé Primitiva</p>

      <h1>Faça Parte do Grupo de Estudos</h1>

      <p>
        Se você deseja acompanhar os estudos e fazer parte do nosso grupo,
        preencha o formulário abaixo.
      </p>
    </div>

    <div class="study-content">

      <div class="google-form-container">

        <iframe
          src="COLE_AQUI_O_LINK_DE_INCORPORAÇÃO_DO_GOOGLE_FORMS"
          width="100%"
          height="900"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="Formulário do Grupo de Estudos"
        >
          Carregando…
        </iframe>

      </div>

    </div>

  </section>

</Layout>